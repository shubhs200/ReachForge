#!/usr/bin/env python3
"""
C++ compiler wrapper for build capture.
Adds sanitizer and fuzzer instrumentation flags, then logs the command.
Also emits LLVM IR for callgraph analysis.
"""
import os, sys, json, subprocess

def main():
    log_path = os.getenv("RF_BUILD_LOG", "rf_build_commands.jsonl")
    real_cxx = os.getenv("REAL_CXX", os.environ.get("CXX", "clang++"))
    
    # Build argv with instrumentation flags. Honour RF_SANITIZER_MODE
    # (mirrors build_capture's choice when ASan+UBSan can't link).
    argv = [real_cxx]
    asan_only = os.getenv("RF_SANITIZER_MODE") == "asan_only"
    if asan_only:
        sanitizer_flags = [
            "-fsanitize=address",
            "-fno-sanitize-recover=all",
            "-fsanitize=fuzzer-no-link",
            "-fno-omit-frame-pointer",
            "-gline-tables-only",
        ]
    else:
        sanitizer_flags = [
            "-fsanitize=address,undefined",
            "-fno-sanitize-recover=all",
            "-fsanitize=fuzzer-no-link",
            "-fno-omit-frame-pointer",
            "-gline-tables-only",
        ]

    # Add flags if not already present
    for flag in sanitizer_flags:
        if flag not in sys.argv:
            argv.append(flag)

    # Add original arguments
    argv.extend(sys.argv[1:])

    # On legacy clang+libc++ toolchains (e.g. clang 9 in OSS-Fuzz Ubuntu 16.04
    # base images), `libclang_rt.asan_cxx-*.a` and `libc++.a`'s
    # `private_typeinfo.cpp` carry typeinfo refs to `__cxxabiv1::__class_type_info`.
    # When linking we need `-lc++abi` (or `-lstdc++` if libc++abi isn't
    # available) so those symbols resolve. Library-agnostic.
    is_compile_only = "-c" in sys.argv
    has_o = any(a == "-o" for a in sys.argv)
    looks_like_link = has_o and not is_compile_only
    if looks_like_link:
        already = set(argv)
        cxx_abi_paths = [
            "/usr/local/lib/libc++abi.so", "/usr/local/lib/libc++abi.a",
            "/usr/lib/libc++abi.so", "/usr/lib/x86_64-linux-gnu/libc++abi.so",
        ]
        stdcxx_paths = [
            "/usr/lib/x86_64-linux-gnu/libstdc++.so",
            "/usr/lib/libstdc++.so", "/usr/local/lib/libstdc++.so",
        ]
        if any(os.path.exists(p) for p in cxx_abi_paths) and \
                "-lc++abi" not in already:
            argv.extend(["-lc++abi"])
        elif any(os.path.exists(p) for p in stdcxx_paths) and \
                "-lstdc++" not in already:
            argv.append("-lstdc++")

    # Find source file and output file for LLVM IR emission
    src_file = None
    out_file = None
    is_compile = False
    for i, arg in enumerate(sys.argv):
        if arg == '-c' and i + 1 < len(sys.argv):
            src_file = sys.argv[i + 1]
            is_compile = True
        elif arg == '-o' and i + 1 < len(sys.argv):
            out_file = sys.argv[i + 1]
    # Infer output when -o is absent (e.g. "cc -c file.c" produces file.o)
    if src_file and not out_file and is_compile:
        out_file = os.path.splitext(os.path.basename(src_file))[0] + '.o'
    
    # Log the command
    entry = {
        "argv": argv,
        "cwd": os.getcwd(),
        "env": {
            "CXXFLAGS": os.environ.get("CXXFLAGS", ""),
            "CPPFLAGS": os.environ.get("CPPFLAGS", ""),
            "LDFLAGS": os.environ.get("LDFLAGS", "")
        }
    }
    
    # If compiling a source file, also emit LLVM IR
    ll_file = None
    if src_file and out_file and src_file.endswith(('.c', '.cc', '.cpp', '.cxx')):
        ll_file = out_file.rsplit('.', 1)[0] + '.ll'
        entry['ll_file'] = ll_file
    
    try:
        with open(log_path, "a") as f:
            f.write(json.dumps(entry) + "\n")
    except Exception:
        pass
    
    # Execute the real compiler
    ret = subprocess.call(argv)
    
    # Also emit LLVM IR for callgraph analysis (separate compilation)
    if src_file and ll_file and ret == 0:
        ll_argv = [real_cxx, "-emit-llvm", "-S", "-O0", "-o", ll_file, "-c", src_file]
        # Add include paths from original args
        for arg in sys.argv[1:]:
            if arg.startswith('-I') or arg.startswith('-D') or arg == '-include':
                ll_argv.append(arg)
            elif arg == '-include' and sys.argv.index(arg) + 1 < len(sys.argv):
                ll_argv.append(sys.argv[sys.argv.index(arg) + 1])
        try:
            subprocess.call(ll_argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass
    
    sys.exit(ret)

if __name__ == "__main__":
    main()
