FROM gitlab.ebossproject.com:5005/sim-performer/build-base/build-base:latest
ENV DEBIAN_FRONTEND=noninteractive

LABEL maintainer="SSRG Research Team"
LABEL description="ReachForge4 - AI-powered fuzz driver + seed generator"
LABEL version="1.0"

# Base packages
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    build-essential libc6-dev gcc-13 g++-13 clang-19 lld-19 \
    python3 python3-venv python3-pip python3-pil \
    cmake ninja-build make \
    tar xz-utils file \
    curl wget git \
    libglib2.0-dev libpixman-1-dev \
    binutils gdb valgrind \
    libcapstone-dev \
    graphviz \
    llvm-19-dev llvm-19-tools libclang-rt-19-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --install /usr/bin/clang clang /usr/bin/clang-19 100 \
    && update-alternatives --install /usr/bin/clang++ clang++ /usr/bin/clang++-19 100 \
    && update-alternatives --install /usr/bin/llvm-config llvm-config /usr/bin/llvm-config-19 100

WORKDIR /opt

# Build and install AFL++ (LLVM mode)
RUN wget -O AFLplusplus-4.09c.tar.gz https://github.com/AFLplusplus/AFLplusplus/archive/refs/tags/v4.09c.tar.gz && \
    tar -xzf AFLplusplus-4.09c.tar.gz && \
    rm AFLplusplus-4.09c.tar.gz && \
    cd AFLplusplus-4.09c && \
    make distrib && \
    make install && \
    cd .. && \
    rm -rf AFLplusplus-4.09c

# Set environment for AFL++ and LLVM
ENV CC=clang-19 \
    CXX=clang++-19 \
    LLVM_CONFIG_PATH=/usr/bin/llvm-config-19 \
    AFL_PATH=/usr/local/lib/afl \
    PATH="/usr/local/bin:${PATH}"

# Python venv
ENV VENV=/opt/rf-venv
RUN python3 -m venv $VENV && $VENV/bin/pip install --upgrade pip
ENV PATH="$VENV/bin:$PATH"

# Copy ReachForge4 tool
WORKDIR /opt/reachforge
COPY requirements.txt ./
RUN pip install -r requirements.txt
COPY . .

# Environment for runtime: ensure parent dir of the package is on sys.path
# This allows `python3 -m reachforge.cli` to work from any CWD in the container
ENV PYTHONPATH=/opt

# Default command prints help
CMD ["python3", "-m", "reachforge.cli", "--help"]
