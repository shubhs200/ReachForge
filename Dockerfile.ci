FROM gitlab.ebossproject.com:5005/sim-performer/build-base/build-base:latest
ENV DEBIAN_FRONTEND=noninteractive

LABEL maintainer="SSRG Research Team"
LABEL description="ReachForge4 - AI-powered fuzz driver + seed generator"
LABEL version="1.0"

# Base packages
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    build-essential libc6-dev gcc-13 g++-13 \
    clang-17 lld-17 \
    python3 python3-venv python3-pip python3-pil \
    cmake ninja-build make \
    tar xz-utils file \
    curl wget git \
    libglib2.0-dev libpixman-1-dev \
    binutils gdb valgrind \
    libcapstone-dev \
    graphviz \
    llvm-17-dev llvm-17-tools libclang-rt-17-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --install /usr/bin/clang clang /usr/bin/clang-17 100 \
    && update-alternatives --install /usr/bin/clang++ clang++ /usr/bin/clang++-17 100 \
    && update-alternatives --install /usr/bin/llvm-config llvm-config /usr/bin/llvm-config-17 100

WORKDIR /opt

# Build and install AFL++ (LLVM mode)
RUN wget -O AFLplusplus-4.09c.tar.gz https://github.com/AFLplusplus/AFLplusplus/archive/refs/tags/v4.09c.tar.gz && \
    tar -xzf AFLplusplus-4.09c.tar.gz && \
    rm AFLplusplus-4.09c.tar.gz && \
    cd AFLplusplus-4.09c && \
    CC=clang-17 CXX=clang++-17 LLVM_CONFIG=llvm-config-17 make distrib && \
    make install

ENV CC=clang-17
ENV CXX=clang++-17
ENV AFL_PATH=/opt/AFLplusplus-4.09c
ENV PATH="/usr/local/bin:$PATH"

# Python venv
ENV VENV=/opt/rf-venv
RUN python3 -m venv $VENV && $VENV/bin/pip install --upgrade pip
ENV PATH="$VENV/bin:$PATH"

# Copy ReachForge4 tool
WORKDIR /opt/reachforge
COPY requirements.txt ./
RUN pip install -r requirements.txt
COPY . .

# Environment for runtime
ENV PYTHONPATH=/opt

CMD ["python3", "-m", "reachforge.cli", "--help"]
